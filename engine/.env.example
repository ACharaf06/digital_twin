# Copy to engine/.env and fill in. Never commit .env, and never put the key in
# a VITE_* variable: Vite inlines those into the public browser bundle.
MODEL=gpt-4o-mini
# Answers, routes and grades with MODEL, and embeds each question for the
# retrieval index. Without it /health reports offline and the studio falls
# back to a disabled chat with no local reply.
OPENAI_API_KEY=
# Retries per model call on 429s and 5xx, with the SDK's backoff.
OPENAI_MAX_RETRIES=2
TWIN_PORT=8000
# Optional Langfuse tracing: one trace per chat turn. Traces include what
# visitors type, so enabling this sends their messages to Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Separates local traces from staging and production dashboards.
LANGFUSE_TRACING_ENVIRONMENT=development
# Comma-separated origins allowed to call /chat (the web app).
ALLOWED_ORIGIN=http://localhost:5173
# The ceiling on /chat, which spends OpenAI quota on every call. A visitor may
# send CHAT_BURST messages at once, then one per CHAT_PER_MINUTE thereafter.
CHAT_BURST=4
CHAT_PER_MINUTE=4
# Backstop across every address, for a day. 0 removes it.
CHAT_DAILY_MAX=200
# How many proxies append to X-Forwarded-For after the visitor's own address:
# 1 behind Cloud Run, 2 with a load balancer in front of it, 1 behind a local
# reverse proxy. Too high files every visitor under one bucket, so check it
# against a real request before trusting the limit.
TRUSTED_PROXY_HOPS=1
